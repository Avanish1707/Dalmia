POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vms_db
POSTGRES_USER=vms_user
POSTGRES_PASSWORD=CHANGE_ME

# Configure all required fields to enable email alert delivery.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ALERT_EMAIL_TO=
MAIL_USE_TLS=
MAIL_USE_SSL=false

# Required for the browser dashboard session. Generate a long random value.
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Existing recognition defaults. Unknown alerts require a face detector score
# of at least UNKNOWN_FACE_MIN_SCORE as well as the person/ROI validation gates.
RECOGNITION_THRESHOLD=0.50
RECOGNITION_CANDIDATE_THRESHOLD=0.43
RECOGNITION_MARGIN=0.05
FACE_RECOGNITION_MIN_DET_SCORE=0.40
UNKNOWN_FACE_MIN_SCORE=0.60
